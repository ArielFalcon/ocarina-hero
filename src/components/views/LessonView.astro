---
import { songArticleHtml } from '../../site/song-article';
import type { SongLink, SongPage } from '../../site/song-pages';

/** The lesson, shown free play until the app opens a song; a song page prerenders its heading, summary, text tab and related songs. */
interface Props { song?: SongPage; related?: readonly SongLink[] }
const { song, related = [] } = Astro.props;
const Title = song ? 'h1' : 'h2';
---
<section id="lesson-view" class="view lesson-view" aria-labelledby="lesson-title" hidden={!song}>
  <div class="lesson-top"><button class="text-button back-link" type="button" data-view-link="catalog"><span data-thread-icon="back"></span><span class="back-label"> Songbook</span></button><span class="lesson-actions"><button id="share-song" class="text-button" type="button" aria-label="Share link to this song" hidden><span data-thread-icon="share"></span><span class="share-label">Share</span></button><button id="save-song" class="text-button" type="button" aria-pressed="false" hidden>Save song</button></span></div>
  <div class="lesson-heading"><p id="lesson-universe" class="eyebrow stitched-label">{song?.universe ?? 'Your instrument'}</p><Title id="lesson-title" class="view-title embroidered">{song?.title ?? 'Free play'}</Title><p id="lesson-meta" class="subtitle stitched-label">{song?.details ?? 'Make a little music.'}</p></div>
  <div id="song-modes" class="mode-switch" role="group" aria-label="Learning mode" hidden>
    <button id="listen-mode" class="action" type="button" aria-pressed="true"><span class="stitched-label">Listen</span></button>
    <button id="practice-mode" class="action" type="button" aria-pressed="false"><span class="stitched-label">Practice</span></button>
  </div>
  <div class="lesson-layout">
    <div class="score-panel">
      <div id="passage-controls" class="passage-controls">
        <button id="previous-passage" class="action passage-arrow" type="button" aria-label="Previous passage"><span data-thread-icon="previous"></span><span class="stitched-label">Previous</span></button>
        <div class="field passage-field"><label for="passage">Passage</label><span class="input-frame select-frame"><select id="passage"></select><span class="select-chevron" aria-hidden="true"></span></span></div>
        <button id="next-passage" class="action passage-arrow" type="button" aria-label="Next passage"><span class="stitched-label">Next</span><span data-thread-icon="next"></span></button>
      </div>
      <div id="tab" class="tab"></div>
      <div id="song-progress" hidden><div class="progress-heading"><span id="progress-caption" class="stitched-label">Song progress</span><span id="progress-percent">0%</span></div><div class="progress-track"><progress id="progress" value="0" max="1" aria-label="Song position"></progress></div><p id="progress-label" class="meta"></p></div>
      <div class="practice-line"><div class="status-slot"><p id="practice-status" class="practice-status" role="status" aria-live="polite">Play any note.</p></div><p id="combo" class="combo-badge" data-tier="0" aria-hidden="true" hidden><span class="combo-count embroidered">×0</span><span class="combo-label">combo</span></p></div>
      <div id="song-complete" class="song-complete" hidden>
        <button id="practice-again" class="action" type="button"><span data-thread-icon="reset"></span><span class="stitched-label">Retry</span></button>
        <button id="next-song" class="action primary" type="button"><span class="stitched-label">Next song</span><span data-thread-icon="next"></span></button>
      </div>
      <div class="playback-controls">
        <button id="play" class="action primary" type="button" disabled><span class="play-icon" data-thread-icon="play"></span><span class="stitched-label">Play</span></button>
        <button id="restart" class="action" type="button" aria-label="Reset"><span data-thread-icon="reset"></span><span class="stitched-label">Reset</span></button>
        <span class="input-frame select-frame rate-field"><span class="rate-icon" data-thread-icon="speed" aria-hidden="true"></span><select id="playback-rate" aria-label="Playback speed" title="Playback speed"><option value="1">100%</option><option value="0.75">75%</option><option value="0.5">50%</option></select><span class="select-chevron" aria-hidden="true"></span></span>
        <label class="toggle repeat-toggle"><input id="repeat-passage" type="checkbox" /><span data-thread-icon="repeat"></span><span class="stitched-label">Repeat passage</span></label>
      </div>
      <details class="lesson-options">
        <summary>Arrangement</summary>
        <label class="toggle"><input id="bends" type="checkbox" checked /><span class="stitched-label">Use bends</span></label>
        <label class="toggle"><input id="simplify" type="checkbox" /><span class="stitched-label">Simplify ornaments</span></label>
        <button id="clear" class="text-button" type="button">Clear and start free play</button>
      </details>
      <p id="song-hint" class="visually-hidden" role="status" aria-live="polite"></p>
    </div>
    <section class="controller-panel" aria-labelledby="controller-title">
      <h2 id="controller-title" class="stitched-label">Your controller</h2>
      <div id="pad" class="pad"></div><div id="bend-pad" class="bends"></div>
      <p id="hint" class="hint" aria-live="off">Press a note to begin.</p>
      <p id="gamepad-status" class="hint desktop-only" role="status" aria-live="polite">Connect a controller and press any of its buttons to play with it.</p>
      <a class="text-button keyboard-link desktop-only" href="#settings" data-view-link="settings"><span data-thread-icon="keyboard"></span><span>Change keyboard keys</span></a>
    </section>
  </div>
  <section id="song-article" class="song-article" aria-label="About this song" hidden={!song} set:html={song && songArticleHtml(song, related, import.meta.env.BASE_URL)} />
</section>
