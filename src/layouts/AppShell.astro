---
import CatalogView from '../components/views/CatalogView.astro';
import LessonView from '../components/views/LessonView.astro';
import PopularView from '../components/views/PopularView.astro';
import SettingsView from '../components/views/SettingsView.astro';
import WorkshopView from '../components/views/WorkshopView.astro';
import ThreadFilters from '../components/ThreadFilters.astro';
import Head from '../components/Head.astro';
import { assetUrl, type PageHead } from '../site/site';
import { DEFAULT_PLATFORM } from '../ui/platforms';
import type { SongLink, SongPage } from '../site/song-pages';
import '../ui/styles.css';
import '../ui/retro.css';
import '../ui/3ds.css';

interface Props {
  page: PageHead;
  /** The song the page opens on; the home opens on the songbook. */
  song?: SongPage;
  /** The other songs of the song's universe, linked below the lesson. */
  related?: readonly SongLink[];
  /** The page opens on the Popular view with the rows of the build's ranking; the home opens on the songbook. */
  popular?: { readonly rows: string; readonly ranking: string };
  /** Crawlable song list shown to visitors without scripts. */
  directory?: string;
}
const { page, song, related, popular, directory } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <Head page={page} />
  </head>
  <body>
    <ThreadFilters />
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class={song ? 'app is-lesson has-song' : 'app'}>
      <picture class="tapestry-art" aria-hidden="true">
        <source media="(min-width: 800px)" srcset={assetUrl('art/tree-desktop.webp')} width="2172" height="724" />
        <img src={assetUrl('art/tree-mobile.webp')} width="1200" height="800" alt="" decoding="async" />
      </picture>
      <div class="retro-art" aria-hidden="true"></div>
      <div class="tapestry-edge" aria-hidden="true"></div>
      <main id="main-content" tabindex="-1">
        <header class="head">
          <a class="brand" href="#catalog"><img class="brand-icon" src={assetUrl(DEFAULT_PLATFORM.art.brand)} data-art="brand" width="192" height="192" alt="" aria-hidden="true" draggable="false" /><span class="embroidered">Ocarina Hero</span></a>
          <span class="head-actions">
          <a class="action settings-link" href="#settings" data-view-link="settings" aria-label="Settings"><span data-thread-icon="settings"></span></a>
          <a class="action repo-link" href="https://github.com/ArielFalcon/ocarina-hero" target="_blank" rel="noopener" aria-label="Star Ocarina Hero on GitHub (opens in a new tab)"><span data-thread-icon="star"></span><span><span class="repo-long">Star on </span>GitHub</span></a>
          </span>
        </header>
        <CatalogView hidden={!!song || !!popular} />
        <LessonView song={song} related={related} />
        <PopularView active={!!popular} rows={popular?.rows} ranking={popular?.ranking} />
        <WorkshopView />
        <SettingsView />
        {directory && <noscript id="song-directory" set:html={directory} />}
      </main>
      <footer class="menu-footer">
        <img class="menu-ornament" src={assetUrl(DEFAULT_PLATFORM.art.ornament)} data-art="ornament" width="1280" height="546" alt="" aria-hidden="true" draggable="false" decoding="async" />
        <section id="mini-player" class="mini-player" aria-label="Quick play" hidden>
          <div class="mini-head">
            <button id="mini-toggle" class="patch-button mini-toggle" type="button" aria-label="Play"></button>
            <button id="mini-open" class="mini-open" type="button" aria-describedby="mini-open-hint"><span class="mini-title"></span><span class="mini-meta"></span><span id="mini-open-hint" class="visually-hidden">Open the full lesson</span></button>
            <button id="mini-expand" class="action mini-expand" type="button" aria-label="Open lesson"><span class="stitched-label">Open</span><span data-thread-icon="next"></span></button>
            <button id="mini-close" class="patch-button" type="button" aria-label="Close quick play"><span data-thread-icon="close"></span></button>
          </div>
          <div class="mini-staff" aria-hidden="true" inert><div class="tab"></div></div>
          <p id="mini-status" class="visually-hidden" role="status" aria-live="polite"></p>
        </section>
        <nav class="app-nav" aria-label="Main navigation"><a href="#catalog" data-view-link="catalog" aria-current={popular ? undefined : 'page'}><span data-thread-icon="songbook"></span><span>Songbook</span></a><a class="nav-saved" href="#saved" data-view-link="saved"><span data-thread-icon="heart"></span><span>Saved</span></a><a class="nav-popular" href={assetUrl('popular/')} data-view-link="popular" aria-current={popular ? 'page' : undefined}><span data-thread-icon="star"></span><span>Popular</span></a><a href="#free" data-view-link="free"><span data-thread-icon="music"></span><span>Free play</span></a><a href="#workshop" data-view-link="workshop"><span data-thread-icon="waveform"></span><span>Workshop</span></a></nav>
      </footer>
    </div>
    <script>
      import '../ui/main.ts';
    </script>
  </body>
</html>
