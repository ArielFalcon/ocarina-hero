---
import type { GetStaticPaths } from 'astro';
import AppShell from '../../layouts/AppShell.astro';
import { groups, pages } from '../../site/songs';
import { SITE_URL } from '../../site/config';
import { relatedSongs, songDirectoryHtml, songHead } from '../../site/song-pages';

export const getStaticPaths = (() => pages.map(song => ({
  params: { id: song.id },
  props: { song, related: relatedSongs(groups, song) },
}))) satisfies GetStaticPaths;

const { song, related } = Astro.props;
---
<AppShell page={songHead(song, SITE_URL)} song={song} directory={songDirectoryHtml(song, related, SITE_URL)} />
