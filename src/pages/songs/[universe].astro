---
import type { GetStaticPaths } from 'astro';
import HubPage from '../../components/HubPage.astro';
import { hubs } from '../../site/songs';

export const getStaticPaths = (() => hubs.filter(hub => hub.kind !== 'zelda').map(hub => ({
  params: { universe: hub.path.replace(/^songs\/|\/$/g, '') },
  props: { hub },
}))) satisfies GetStaticPaths;

const { hub } = Astro.props;
---
<HubPage hub={hub} />
